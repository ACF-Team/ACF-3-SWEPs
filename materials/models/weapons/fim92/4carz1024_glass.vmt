// Stand-in for L4D2's car glass, which the model was built with
"VertexLitGeneric"
{
	"$basetexture" "models/weapons/fim92/car_glass"
	"$translucent" "1"
	"$envmap" "env_cubemap"
	"$envmapmask" "models/weapons/fim92/car_glass_ref"
	"$envmaptint" "[.65 .65 .65]"
	"$envmapcontrast" ".5"
	"$envmapsaturation" ".5"
}
